# Application runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Local SQLite database and private file storage
DATABASE_PATH=./var/motion-market.db
PRIVATE_STORAGE_PATH=./var/private

# Browser origin allowed to make session-bound API writes
ALLOWED_ORIGIN=http://localhost:5173

# Authentication and CSRF signing secrets.
# Required in production: replace both with independent random values of at least 32 characters.
# These values are development-only and must never be reused in production.
SESSION_SECRET=development-only-session-secret-please-change
CSRF_SECRET=development-only-csrf-secret-please-change

# Development fixtures. Keep false for the real API.
USE_FIXTURES=false

# Reserved mock USDT toggle. Must remain false outside tests.
MOCK_USDT_ENABLED=false

# Stripe test-mode integration. Optional for running without Checkout/Connect.
# Required to create Stripe Checkout Sessions and Connect accounts; use a test secret only.
STRIPE_SECRET_KEY=

# Stripe webhook signing secrets, each from the corresponding `stripe listen` endpoint.
# Required to process the respective webhook route.
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Checkout redirects after payment or cancellation.
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/library?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/checkout/cancel

# Connect onboarding redirect URLs.
STRIPE_CONNECT_RETURN_URL=http://localhost:5173/seller/connect/return
STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/seller/connect/refresh
