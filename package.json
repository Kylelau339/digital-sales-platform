{
  "name": "motion-market",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "build": "npm run typecheck && vite build --config vite.config.ts && tsup apps/api/src/server.ts --format esm --platform node --out-dir dist/api --external better-sqlite3 --external argon2",
    "db:migrate": "tsx apps/api/src/db/cli.ts",
    "start": "node dist/api/server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^10.3.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.2.0",
    "fastify": "^5.6.1",
    "i18next": "^25.6.0",
    "kysely": "^0.28.8",
    "nodemailer": "^7.0.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.0",
    "react-router-dom": "^7.9.5",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1",
    "yauzl": "^3.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.1",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "yazl": "^3.3.1"
  }
}
